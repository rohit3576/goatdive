; Engine configuration file.
; GoatDive — Phase 1 project foundation.
; Renderer: Compatibility (web export requirement, decision D1).

config_version=5

[application]

config/name="GoatDive"
config/description="First-person 3D mountain goat racing game."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/game/config.gd"
GameState="*res://scripts/game/game_state.gd"
EventBus="*res://scripts/game/event_bus.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

